rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('email', '') in [
          'gimdong2804@gmail.com',
          'sjh20110407@gmail.com'
        ];
    }

    function owns(data) {
      return signedIn() && (
        (data.keys().hasAny(['uid']) && data.uid == request.auth.uid)
        || (data.keys().hasAny(['authorUid']) && data.authorUid == request.auth.uid)
      );
    }

    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function isPostOwner(postId) {
      return owns(get(/databases/$(database)/documents/posts/$(postId)).data);
    }

    function hasValidAuthor(author) {
      let email = request.auth.token.get('email', '');
      let accountName = request.auth.token.get('name', '');
      return signedIn()
        && author is string
        && author.size() > 0
        && author.size() <= 80
        && (
          isAdmin()
          || author == accountName
          || (accountName == '' && author == '회원')
          || (
            email != ''
            && exists(/databases/$(database)/documents/userRoles/$(email))
            && author == get(/databases/$(database)/documents/userRoles/$(email)).data.get('roleName', '')
          )
        );
    }

    function isLikeToggle() {
      let oldUsers = resource.data.get('likedUsers', []);
      let newUsers = request.resource.data.get('likedUsers', []);
      let oldLikes = resource.data.get('likes', 0);
      let newLikes = request.resource.data.get('likes', 0);
      return signedIn()
        && oldUsers is list
        && newUsers is list
        && oldLikes is int
        && newLikes is int
        && newLikes >= 0
        && changedOnly(['likes', 'likedUsers'])
        && (
          (
            !oldUsers.hasAny([request.auth.uid])
            && newUsers.hasAny([request.auth.uid])
            && newUsers.hasAll(oldUsers)
            && newUsers.size() == oldUsers.size() + 1
            && newLikes == oldLikes + 1
          )
          || (
            oldUsers.hasAny([request.auth.uid])
            && !newUsers.hasAny([request.auth.uid])
            && oldUsers.hasAll(newUsers)
            && newUsers.size() == oldUsers.size() - 1
            && newLikes == oldLikes - 1
          )
        );
    }

    function isPostViewUpdate() {
      let oldUsers = resource.data.get('viewedBy', []);
      let newUsers = request.resource.data.get('viewedBy', []);
      let oldViews = resource.data.get('views', 0);
      let newViews = request.resource.data.get('views', 0);
      return signedIn()
        && oldUsers is list
        && newUsers is list
        && oldViews is int
        && newViews is int
        && changedOnly(['views', 'viewedBy'])
        && !oldUsers.hasAny([request.auth.uid])
        && newUsers.hasAny([request.auth.uid])
        && newUsers.hasAll(oldUsers)
        && newUsers.size() == oldUsers.size() + 1
        && newViews == oldViews + 1;
    }

    function isValidPostContentUpdate() {
      return request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 10000
        && request.resource.data.categoryMain is string
        && request.resource.data.categoryMain.size() <= 80
        && request.resource.data.categorySub is string
        && request.resource.data.categorySub.size() <= 80
        && request.resource.data.get('images', []) is list
        && request.resource.data.get('images', []).size() <= 40
        && request.resource.data.get('attachments', []) is list
        && request.resource.data.get('attachments', []).size() <= 40;
    }

    function isValidCommentContentUpdate() {
      return request.resource.data.get('body', '') is string
        && request.resource.data.get('body', '').size() <= 5000
        && request.resource.data.get('images', []) is list
        && request.resource.data.get('images', []).size() <= 10
        && request.resource.data.get('videos', []) is list
        && request.resource.data.get('videos', []).size() <= 10
        && request.resource.data.get('audios', []) is list
        && request.resource.data.get('audios', []).size() <= 10
        && request.resource.data.get('pdfs', []) is list
        && request.resource.data.get('pdfs', []).size() <= 10
        && request.resource.data.get('htmls', []) is list
        && request.resource.data.get('htmls', []).size() <= 10;
    }

    function isValidCommentParent(postId, commentId, parentId) {
      return parentId == null
        || (
          parentId is string
          && parentId.matches('^[A-Za-z0-9_-]{1,128}$')
          && parentId != commentId
          && exists(/databases/$(database)/documents/posts/$(postId)/comments/$(parentId))
        );
    }

    match /userRoles/{accountEmail} {
      allow get: if isAdmin()
        || (signedIn() && request.auth.token.get('email', '') == accountEmail);
      allow list, create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;

      match /{privateDocument=**} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
    }

    match /posts/{postId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && postId.matches('^[A-Za-z0-9_-]{1,128}$')
        && request.resource.data.keys().hasOnly([
          'title', 'author', 'uid', 'userPhoto', 'categoryMain', 'categorySub',
          'body', 'images', 'attachments', 'createdAt',
          'views', 'viewedBy', 'likes', 'likedUsers'
        ])
        && request.resource.data.uid == request.auth.uid
        && hasValidAuthor(request.resource.data.author)
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 10000
        && request.resource.data.categoryMain is string
        && request.resource.data.categoryMain.size() <= 80
        && request.resource.data.categorySub is string
        && request.resource.data.categorySub.size() <= 80
        && request.resource.data.userPhoto is string
        && request.resource.data.images is list
        && request.resource.data.images.size() <= 40
        && request.resource.data.attachments is list
        && request.resource.data.attachments.size() <= 40
        && request.resource.data.createdAt is timestamp
        && request.resource.data.views == 0
        && request.resource.data.viewedBy == []
        && request.resource.data.likes == 0
        && request.resource.data.likedUsers == [];

      allow update: if isAdmin()
        || (
          owns(resource.data)
          && changedOnly([
            'title', 'body', 'categoryMain', 'categorySub',
            'images', 'attachments', 'imageDescriptions'
          ])
          && isValidPostContentUpdate()
        )
        || isPostViewUpdate()
        || isLikeToggle();

      allow delete: if isAdmin() || owns(resource.data);

      match /comments/{commentId} {
        allow read: if signedIn();

        allow create: if signedIn()
          && commentId.matches('^[A-Za-z0-9_-]{1,128}$')
          && request.resource.data.keys().hasOnly([
            'author', 'uid', 'userPhoto', 'body', 'images', 'videos', 'audios',
            'pdfs', 'htmls', 'imageDescriptions', 'parentId', 'replyToAuthor',
            'pinned', 'likes', 'likedUsers', 'deleted', 'createdAt', 'official'
          ])
          && request.resource.data.uid == request.auth.uid
          && hasValidAuthor(request.resource.data.author)
          && request.resource.data.official == isAdmin()
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 5000
          && request.resource.data.userPhoto is string
          && request.resource.data.images is list
          && request.resource.data.images.size() <= 10
          && request.resource.data.videos is list
          && request.resource.data.videos.size() <= 10
          && request.resource.data.audios is list
          && request.resource.data.audios.size() <= 10
          && request.resource.data.pdfs is list
          && request.resource.data.pdfs.size() <= 10
          && request.resource.data.htmls is list
          && request.resource.data.htmls.size() <= 10
          && request.resource.data.imageDescriptions is map
          && isValidCommentParent(postId, commentId, request.resource.data.parentId)
          && request.resource.data.replyToAuthor is string
          && request.resource.data.replyToAuthor.size() <= 80
          && request.resource.data.createdAt is timestamp
          && request.resource.data.pinned == false
          && request.resource.data.likes == 0
          && request.resource.data.likedUsers == []
          && request.resource.data.deleted == false;

        allow update: if isAdmin()
          || (
            owns(resource.data)
            && changedOnly([
              'body', 'content', 'images', 'videos', 'audios', 'pdfs', 'htmls',
              'imageDescriptions', 'edited', 'editedAt', 'deleted', 'deletedAt'
            ])
            && isValidCommentContentUpdate()
          )
          || (isPostOwner(postId) && changedOnly(['pinned']))
          || isLikeToggle();

        allow delete: if isAdmin() || owns(resource.data) || isPostOwner(postId);
      }
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
